DATABASE_URL=postgres://postgres:postgres@localhost:5432/newhumans
# Optional: integration-test shard creation role when DATABASE_URL itself lacks CREATEDB.
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/newhumans
PORT=3000
NODE_ENV=development
LOCAL_DEV_BOOTSTRAP=true
KB_PROVIDER=knowledge-ball
KB_ENDPOINT=http://127.0.0.1:8787

# M06 connector rows store only an environment-variable name, never this value.
# Example for a real connector after you deliberately configure one:
# OPENAI_API_KEY=replace-with-a-real-secret-outside-version-control
