{
  "name": "newhumans",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node scripts/start.js",
    "migrate": "node scripts/migrate.js",
    "check": "node scripts/check.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node scripts/test-db-harness.js --shards=4",
    "test:integration:serial": "node scripts/test-db-harness.js --shards=1",
    "test:integration:verify": "node scripts/test-db-harness.js --shards=4 --verify-serial",
    "test": "npm run check && npm run test:unit && npm run test:integration:verify"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pg": "^8.13.1"
  }
}
