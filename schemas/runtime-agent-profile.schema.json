{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newhumans.world/schemas/runtime-agent-profile.schema.json",
  "title": "M02 Agent runtime profile nh.v3.0",
  "type": "object",
  "required": ["world_id", "agent_entity_id", "memory_subject_id", "profile_version"],
  "properties": {
    "world_id": { "type": "string", "minLength": 1 },
    "agent_entity_id": { "type": "string", "format": "uuid" },
    "memory_subject_id": { "type": "string", "format": "uuid" },
    "current_route_id": { "type": ["string", "null"], "format": "uuid" },
    "profile_version": {
      "anyOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "pattern": "^[1-9]\\d*$" }
      ]
    },
    "created_by": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
