{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newhumans.world/schemas/sandbox-execution.schema.json",
  "title": "M06 sandbox execution contract nh.v3.0",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "required": ["executable", "argv", "cwd"],
      "properties": {
        "executable": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "argv": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "maxLength": 8192 }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["cpu_millis", "memory_bytes", "wall_time_ms", "disk_bytes"],
      "properties": {
        "cpu_millis": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "wall_time_ms": { "type": "integer", "minimum": 1 },
        "disk_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": ["mode", "allow_hosts"],
      "properties": {
        "mode": { "enum": ["DENY_ALL", "ALLOWLIST"] },
        "allow_hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "mode": { "const": "DENY_ALL" } }, "required": ["mode"] },
          "then": { "type": "object", "properties": { "allow_hosts": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "type": "object", "properties": { "mode": { "const": "ALLOWLIST" } }, "required": ["mode"] },
          "then": { "type": "object", "properties": { "allow_hosts": { "type": "array", "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "artifactRequest": {
      "type": "object",
      "required": ["path", "required", "max_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "required": { "type": "boolean" },
        "max_bytes": { "type": "integer", "minimum": 1 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "additionalProperties": false
    },
    "artifactResult": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "additionalProperties": false
    },
    "exit": {
      "type": "object",
      "required": ["reason", "code", "signal"],
      "properties": {
        "reason": {
          "enum": [
            "COMPLETED",
            "NONZERO_EXIT",
            "SIGNALLED",
            "CPU_LIMIT_EXCEEDED",
            "MEMORY_LIMIT_EXCEEDED",
            "TIME_LIMIT_EXCEEDED",
            "DISK_LIMIT_EXCEEDED",
            "NETWORK_DENIED",
            "INVALID_REQUEST",
            "START_FAILED",
            "EXECUTOR_ERROR"
          ]
        },
        "code": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] },
        "detail": { "type": "string", "maxLength": 2048 }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["cpu_millis", "memory_peak_bytes", "wall_time_ms", "disk_bytes", "network_requests"],
      "properties": {
        "cpu_millis": { "type": "integer", "minimum": 0 },
        "memory_peak_bytes": { "type": "integer", "minimum": 0 },
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "disk_bytes": { "type": "integer", "minimum": 0 },
        "network_requests": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["contract_version", "kind", "execution_id", "command", "limits", "network", "artifacts"],
      "properties": {
        "contract_version": { "const": "nh.sandbox.v1" },
        "kind": { "const": "request" },
        "execution_id": { "type": "string", "format": "uuid" },
        "command": { "$ref": "#/$defs/command" },
        "limits": { "$ref": "#/$defs/limits" },
        "network": { "$ref": "#/$defs/networkPolicy" },
        "artifacts": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/artifactRequest" }
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["contract_version", "kind", "execution_id", "exit", "usage", "artifacts"],
      "properties": {
        "contract_version": { "const": "nh.sandbox.v1" },
        "kind": { "const": "result" },
        "execution_id": { "type": "string", "format": "uuid" },
        "exit": { "$ref": "#/$defs/exit" },
        "usage": { "$ref": "#/$defs/usage" },
        "artifacts": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/artifactResult" }
        }
      },
      "additionalProperties": false
    }
  }
}
