{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newhumans.world/schemas/runtime-checkpoint.schema.json",
  "title": "M02 fenced runtime checkpoint nh.v3.0",
  "type": "object",
  "required": ["checkpoint_id", "activity_subject_id", "lease_epoch", "state_version", "event_cursor", "current_plan", "pending_actions", "state_summary"],
  "properties": {
    "checkpoint_id": { "type": "string", "format": "uuid" },
    "activity_subject_id": { "type": "string", "format": "uuid" },
    "lease_epoch": {
      "anyOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "pattern": "^[1-9]\\d*$" }
      ]
    },
    "state_version": {
      "anyOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "pattern": "^[1-9]\\d*$" }
      ]
    },
    "event_cursor": { "type": "object" },
    "current_plan": { "type": "object" },
    "pending_actions": { "type": "array" },
    "state_summary": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
