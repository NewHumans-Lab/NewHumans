{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newhumans.world/schemas/organization.schema.json",
  "title": "M04 organization nh.v3.0",
  "type": "object",
  "required": [
    "schema_version",
    "organization_id",
    "world_id",
    "entity_type",
    "version",
    "charter",
    "roles",
    "members",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "nh.v3.0" },
    "organization_id": { "type": "string", "format": "uuid" },
    "world_id": { "type": "string", "minLength": 1 },
    "entity_type": { "enum": ["COMPANY", "ORGANIZATION"] },
    "version": { "type": "integer", "minimum": 1 },
    "charter": { "$ref": "#/$defs/charter" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/role" }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/member" }
    },
    "asset_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "contract_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "status": { "enum": ["ACTIVE", "DISSOLVING", "DISSOLVED"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "roleName": {
      "enum": ["OWNER", "DIRECTOR", "MANAGER", "SIGNER", "MEMBER"]
    },
    "role": {
      "type": "object",
      "required": ["role", "label"],
      "properties": {
        "role": { "$ref": "#/$defs/roleName" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": ["member_entity_id", "roles", "status", "membership_version", "joined_at"],
      "properties": {
        "member_entity_id": { "type": "string", "format": "uuid" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/roleName" }
        },
        "status": { "enum": ["ACTIVE", "LEFT", "REMOVED"] },
        "membership_version": { "type": "integer", "minimum": 1 },
        "joined_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "charter": {
      "type": "object",
      "required": [
        "version",
        "purpose",
        "signing_threshold",
        "signing_roles",
        "dissolution_procedure",
        "effective_at"
      ],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "signing_threshold": { "type": "integer", "minimum": 1 },
        "signing_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/roleName" }
        },
        "dissolution_procedure": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "effective_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
