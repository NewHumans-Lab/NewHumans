{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newhumans.world/schemas/thread.schema.json",
  "title": "M04 communication thread nh.v3.0",
  "type": "object",
  "required": [
    "schema_version",
    "thread_id",
    "world_id",
    "created_by",
    "participant_entity_ids",
    "causation_id",
    "correlation_id",
    "version",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "nh.v3.0" },
    "thread_id": { "type": "string", "format": "uuid" },
    "world_id": { "type": "string", "minLength": 1 },
    "created_by": { "type": "string", "format": "uuid" },
    "participant_entity_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "causation_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "closed_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
