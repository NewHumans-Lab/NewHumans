{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newhumans.world/schemas/directory-profile.schema.json",
  "title": "M04 Directory profile nh.v3.0",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "world_id",
    "entity_id",
    "services",
    "availability",
    "collaboration_preferences",
    "contact_rules",
    "accepts_new_work",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "nh.v3.0" },
    "profile_id": { "type": "string", "format": "uuid" },
    "world_id": { "type": "string", "minLength": 1 },
    "entity_id": { "type": "string", "format": "uuid" },
    "headline": { "type": ["string", "null"], "maxLength": 240 },
    "summary": { "type": ["string", "null"], "maxLength": 4000 },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service_key", "title", "domains"],
        "properties": {
          "service_key": { "type": "string", "minLength": 1, "maxLength": 128 },
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "description": { "type": ["string", "null"], "maxLength": 2000 },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "additionalProperties": false
      }
    },
    "availability": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["AVAILABLE", "LIMITED", "UNAVAILABLE", "UNKNOWN"] },
        "available_from": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "note": { "type": ["string", "null"], "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "collaboration_preferences": {
      "type": "object",
      "required": ["languages", "task_domains", "work_modes"],
      "properties": {
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "task_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "work_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["ASYNC", "SYNC", "EITHER"] }
        }
      },
      "additionalProperties": false
    },
    "contact_rules": {
      "type": "object",
      "required": ["allow_unknown_senders", "accepts_inbound_offers", "allowed_message_types"],
      "properties": {
        "allow_unknown_senders": { "type": "boolean" },
        "accepts_inbound_offers": { "type": "boolean" },
        "allowed_message_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "additionalProperties": false
    },
    "accepts_new_work": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
