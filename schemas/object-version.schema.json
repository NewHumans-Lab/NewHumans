{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newhumans.world/schemas/object-version.schema.json",
  "title": "M04 ObjectVersion nh.v3.0",
  "type": "object",
  "required": [
    "schema_version",
    "object_version_id",
    "object_id",
    "version",
    "parent_version_id",
    "content_ref",
    "content_digest",
    "author_entity_id",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "nh.v3.0" },
    "object_version_id": { "type": "string", "format": "uuid" },
    "object_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "parent_version_id": { "type": ["string", "null"], "format": "uuid" },
    "content_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Reference to externally stored object content; raw content is not embedded in this contract."
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_id", "object_version_id"],
        "properties": {
          "object_id": { "type": "string", "format": "uuid" },
          "object_version_id": { "type": "string", "format": "uuid" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "change_summary": { "type": ["string", "null"], "maxLength": 10000 },
    "author_entity_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 1 } }, "required": ["version"] },
      "then": { "properties": { "parent_version_id": { "type": "null" } } },
      "else": { "properties": { "parent_version_id": { "type": "string", "format": "uuid" } } }
    }
  ],
  "additionalProperties": false
}
