{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newhumans.world/schemas/contract-version.schema.json",
  "title": "M04 contract version nh.v3.0",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "version",
    "employer_entity_id",
    "contractor_entity_id",
    "scope",
    "deliverables",
    "acceptance_criteria",
    "price_micro_e",
    "start_condition",
    "delivery_deadline",
    "acceptance_deadline",
    "rework_limit",
    "cancellation_terms",
    "dispute_procedure",
    "auto_acceptance",
    "inference_cost_payer",
    "rules_version",
    "terms_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "nh.v3.0" },
    "contract_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "employer_entity_id": { "type": "string", "format": "uuid" },
    "contractor_entity_id": { "type": "string", "format": "uuid" },
    "scope": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["deliverable_id", "description"],
        "properties": {
          "deliverable_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "minLength": 1, "maxLength": 10000 }
        },
        "additionalProperties": true
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "description"],
        "properties": {
          "criterion_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "evidence_required": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "price_micro_e": { "type": "string", "pattern": "^\\d+$" },
    "prepayment_micro_e": { "type": ["string", "null"], "pattern": "^\\d+$" },
    "inference_budget_micro_e": { "type": ["string", "null"], "pattern": "^\\d+$" },
    "start_condition": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "delivery_deadline": { "type": "string", "format": "date-time" },
    "acceptance_deadline": { "type": "string", "format": "date-time" },
    "rework_limit": { "type": "integer", "minimum": 0 },
    "cancellation_terms": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "dispute_procedure": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "auto_acceptance": {
      "type": "object",
      "required": ["enabled", "timeout_action"],
      "properties": {
        "enabled": { "type": "boolean" },
        "timeout_action": { "enum": ["ACCEPT", "ESCALATE", "CANCEL"] }
      },
      "additionalProperties": true
    },
    "inference_cost_payer": { "enum": ["EMPLOYER", "CONTRACTOR", "SPLIT", "EXTERNAL_SPONSOR"] },
    "rules_version": { "type": "string", "minLength": 1, "maxLength": 200 },
    "terms_digest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
