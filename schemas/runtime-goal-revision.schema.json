{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newhumans.world/schemas/runtime-goal-revision.schema.json",
  "title": "M02 goal revision nh.v3.0",
  "type": "object",
  "required": ["revision_id","world_id","subject_id","goal_id","version","source","goal_text","priority","success_evidence","status","change_reason","created_by","created_at"],
  "properties": {
    "revision_id": {"type":"string","format":"uuid"},
    "world_id": {"type":"string","minLength":1},
    "subject_id": {"type":"string","format":"uuid"},
    "goal_id": {"type":"string","format":"uuid"},
    "version": {"anyOf":[{"type":"integer","minimum":1},{"type":"string","pattern":"^[1-9]\\d*$"}]},
    "source": {"enum":["SELF","OWNER_DIRECTIVE","CONTRACT_OBLIGATION","SYSTEM_OBLIGATION"]},
    "goal_text": {"type":"string","minLength":1,"maxLength":10000},
    "priority": {"type":"integer"},
    "rationale": {"anyOf":[{"type":"string"},{"type":"null"}]},
    "budget_micro_e": {"anyOf":[{"type":"integer","minimum":0},{"type":"string","pattern":"^\\d+$"},{"type":"null"}]},
    "deadline": {"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},
    "parent_goal_id": {"anyOf":[{"type":"string","format":"uuid"},{"type":"null"}]},
    "success_evidence": {"type":"object"},
    "status": {"enum":["PROPOSED","ACTIVE","PAUSED","BLOCKED","COMPLETED","ABANDONED","FAILED"]},
    "change_reason": {"type":"string","minLength":1,"maxLength":2000},
    "created_by": {"type":"string","format":"uuid"},
    "created_at": {"type":"string","format":"date-time"}
  },
  "additionalProperties": true
}
